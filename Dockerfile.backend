# Production Dockerfile for CRX Backend (Section 81)
FROM node:22-alpine
WORKDIR /app

RUN addgroup -S crxgroup && adduser -S crxuser -G crxgroup

COPY package.json ./
RUN npm install

COPY . .

RUN mkdir -p /app/private_uploads /app/data && chown -R crxuser:crxgroup /app

USER crxuser
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3000/health || exit 1
CMD ["npm", "run", "start"]
