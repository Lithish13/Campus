# Campus Resource Exchange (CRX) — Environment Configuration Template
# Never commit real production secrets (.env is git-ignored).

# Server & Custom Domain Configuration (Sections 82 & 83)
NODE_ENV="development"
PORT="3000"
APP_URL="https://your-domain.com"
FRONTEND_URL="https://your-domain.com"
VITE_API_BASE_URL=""

# Authentication & Cryptographic Secrets (Must be strong 256-bit random strings in production)
JWT_SECRET="replace-with-strong-64-char-hex-secret-in-production"

# Relational PostgreSQL Connection (Used in Docker / Spring Boot / PostgreSQL deployments)
POSTGRES_DB="crx_production"
POSTGRES_USER="crx_app"
POSTGRES_PASSWORD="replace-with-strong-database-password"
DATABASE_URL="postgresql://crx_app:replace-with-strong-database-password@postgres:5432/crx_production"

# Optional AI Studio / Gemini Environment Variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"
